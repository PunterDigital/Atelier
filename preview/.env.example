# Environment for the one-time preview infrastructure (docker-compose.infra.yml).
# Copy to preview/.env on the host and fill in. This file configures the shared
# Postgres and Traefik only - per-PR values are supplied by the deploy script.

# Superuser password for the shared preview Postgres. The deploy/teardown
# scripts and the GitHub Actions secret PREVIEW_POSTGRES_PASSWORD must match it.
POSTGRES_PASSWORD=change-me

# Contact email Let's Encrypt uses for expiry notices on the preview certs.
ACME_EMAIL=you@example.com
